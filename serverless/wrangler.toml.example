name = "maturita-desk-fact-check"
main = "fact-check-worker.mjs"
compatibility_date = "2026-08-01"

[vars]
# Exact Maturita Desk origin. Origin is supplemental CORS protection, not authentication.
ALLOWED_ORIGINS = "https://maturita.ghrabuvka.cz"
OPENAI_FACTCHECK_MODEL = "gpt-5.6-terra"

# Choose EXACTLY ONE authorization mode:
#
# A) Temporary serverless/browser mode:
#    secret FACTCHECK_ACCESS_TOKEN (min. 32 chars)
#
# B) Future school/edge inner-gate mode:
#    secret FACTCHECK_GATE_TOKEN (min. 32 chars)
#
# In both modes also configure secret OPENAI_API_KEY.
# Never place secret values in this file or in public PWA configuration.
#
# Required in both modes: bind FACTCHECK_RATE_LIMITER.
