{
  "schema": "maturita-desk-runtime-v1",
  "version": 1,
  "environmentId": "school-production",
  "mode": "school-server",
  "serverBaseUrl": "/api/v1/maturita-desk/",
  "allowedOrigins": [
    "self"
  ],
  "auth": {
    "provider": "school-server-session",
    "sessionEndpoint": "session",
    "loginUrl": "/auth/login/maturita-desk",
    "logoutEndpoint": "session/logout",
    "offlineLease": {
      "enabled": true,
      "maxHours": 24,
      "publicKeys": {}
    }
  },
  "content": {
    "provider": "school-server-encrypted-pack",
    "activePackEndpoint": "content/active",
    "allowManualImport": false,
    "requirePublisherSignatureFor": [
      "CONFIDENTIAL-EXAM"
    ],
    "publisherKeys": {
      "ghrab-maturita-content-2026-01": {
        "key_ops": [
          "verify"
        ],
        "ext": true,
        "kty": "EC",
        "x": "0bufZcuDqZL1hDWvpfe8RPPah7rPHCVj4GhZ0lnOqek",
        "y": "xxGraQfMwKSHq4C0ExltO6syXWvl-zdGiQ25bMXcqeU",
        "crv": "P-256"
      }
    }
  },
  "factCheck": {
    "provider": "school-server",
    "endpoint": "fact-check",
    "timeoutMs": 18000
  },
  "trust": {
    "expectedMode": "school-server",
    "expectedEnvironmentId": "school-production",
    "appOrigins": [
      "https://school.example"
    ],
    "confidentialContentOrigins": [
      "https://school.example"
    ],
    "allowLocalhostConfidential": false
  }
}
